diff --git a/CMakeLists.txt b/CMakeLists.txt
index f1c5bc1..781f08a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -410,6 +410,22 @@ add_definitions(-DwxUSE_UNICODE -D_UNICODE -DUNICODE -DWXINTL_NO_GETTEXT_MACRO)
 # Disable unsafe implicit wxString to const char* / std::string and vice versa. This implicit conversion breaks the UTF-8 encoding quite often.
 add_definitions(-DwxNO_UNSAFE_WXSTRING_CONV)
 
+# Bamburino build identity: exposed by app.get_capabilities (buildSuffix, patchId) and shown in About.
+# Passed by driver/build.ps1 -Step app (-DBAMBURINO_PATCH_ID, -DBAMBURINO_BUILD_SUFFIX); "unknown" when absent.
+# Read once and dropped from the cache, so a configure without -D never reuses a stale value.
+# Written to a generated header included only by McpTools.cpp and AboutDialog.cpp: a new patch_id rebuilds
+# those two files, not the tree or the precompiled header. SLIC3R_VERSION and version.inc are left unchanged.
+foreach (_bamburino_var BAMBURINO_PATCH_ID BAMBURINO_BUILD_SUFFIX)
+    set(_bamburino_value "unknown")
+    if (DEFINED ${_bamburino_var} AND NOT "${${_bamburino_var}}" STREQUAL "")
+        set(_bamburino_value "${${_bamburino_var}}")
+    endif ()
+    unset(${_bamburino_var} CACHE)
+    set(${_bamburino_var} "${_bamburino_value}")
+endforeach ()
+message(STATUS "Bamburino identity: BAMBURINO_PATCH_ID=${BAMBURINO_PATCH_ID} BAMBURINO_BUILD_SUFFIX=${BAMBURINO_BUILD_SUFFIX}")
+configure_file(${LIBDIR}/slic3r/GUI/bamburino_identity.h.in ${LIBDIR_BIN}/platform/bamburino_identity.h @ONLY)
+
 if (SLIC3R_PROFILE)
     message("BambuStudio will be built with a Shiny invasive profiler")
     add_definitions(-DSLIC3R_PROFILE)
