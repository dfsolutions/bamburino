+# Bamburino build identity: exposed by app.get_capabilities (buildSuffix, patchId) and shown in About.
+# Passed by driver/build.ps1 -Step app; SLIC3R_VERSION and version.inc are left unchanged.
+set(BAMBURINO_PATCH_ID "unknown" CACHE STRING "Bamburino driver patch_id (12 hex)")
+set(BAMBURINO_BUILD_SUFFIX "unknown" CACHE STRING "Bamburino build suffix (bamburino.<patch_id>)")
+add_compile_definitions(BAMBURINO_PATCH_ID="${BAMBURINO_PATCH_ID}")
+add_compile_definitions(BAMBURINO_BUILD_SUFFIX="${BAMBURINO_BUILD_SUFFIX}")
+
 if (SLIC3R_PROFILE)
     message("BambuStudio will be built with a Shiny invasive profiler")
     add_definitions(-DSLIC3R_PROFILE)
