+    });
+}
diff --git a/src/slic3r/GUI/McpBatch.inc b/src/slic3r/GUI/McpBatch.inc
new file mode 100644
index 0000000..b835ae2
--- /dev/null
+++ b/src/slic3r/GUI/McpBatch.inc
@@ -0,0 +1,160 @@
+struct SliceBatchJob {
+    std::string id, status = "running", error, input_fingerprint;
+    std::vector<int> plate_indices;
+    Json results = Json::array();
+    std::size_t next_index = 0;
+    std::uint64_t current_run = 0;
+    int stopped_plate_index = -1;
+    bool cancel_requested = false, completion_observed = false;
+};
+
+std::deque<SliceBatchJob> slice_batches;
+std::uint64_t next_batch_run = 0;
+
+SliceBatchJob* find_batch_job(const std::string& id) {
+    for (auto& job : slice_batches) if (job.id == id) return &job;
+    return nullptr;
+}
+
+bool batch_active() {
+    return std::any_of(slice_batches.begin(), slice_batches.end(),
+        [](const SliceBatchJob& job) { return !job.completion_observed; });
+}
+
+Json batch_job_state(const SliceBatchJob& job) {
+    Json error = job.error.empty() ? Json(nullptr) : Json{{"code", job.status == "stale" ? "STALE_REFERENCE" : "NATIVE_ERROR"}, {"message", job.error}};
+    Json current = nullptr;
+    if (job.current_run) if (auto* child = slice_jobs.find(job.current_run)) current = child->id;
+    return {{"jobId", job.id}, {"kind", "slice_batch"}, {"status", job.status},
+        {"plateIndices", job.plate_indices}, {"completedPlateCount", job.results.size()},
+        {"stoppedPlateIndex", job.stopped_plate_index < 0 ? Json(nullptr) : Json(job.stopped_plate_index)},
+        {"results", job.results}, {"currentJobId", current}, {"cancelRequested", job.cancel_requested},
+        {"completionObserved", job.completion_observed}, {"error", error}};
+}
+
+void finish_batch(SliceBatchJob& job, std::string status, std::string error = {}) {
+    job.status = std::move(status);
+    job.error = std::move(error);
+    job.current_run = 0;
+    job.completion_observed = true;
+}
+
+void advance_batch(Plater& plater, const std::string& id) {
+    auto* batch = find_batch_job(id);
+    if (!batch || batch->completion_observed) return;
+    if (batch->next_index >= batch->plate_indices.size()) { finish_batch(*batch, "succeeded"); return; }
+    if (batch->cancel_requested) {
+        batch->stopped_plate_index = batch->plate_indices[batch->next_index];
+        finish_batch(*batch, "cancelled");
+        return;
+    }
+    if (slice_fingerprint(plater, true) != batch->input_fingerprint) {
+        batch->stopped_plate_index = batch->plate_indices[batch->next_index];
+        finish_batch(*batch, "stale", "Native slice inputs changed during the plate queue");
+        return;
+    }
+    while (batch->next_index < batch->plate_indices.size()) {
+        const int plate_index = batch->plate_indices[batch->next_index];
+        if (plate_index >= plater.get_partplate_list().get_plate_count()) {
+            batch->stopped_plate_index = plate_index;
+            finish_batch(*batch, "stale", "Plate list changed during the slice queue");
+            return;
+        }
+        try {
+            if (plater.get_partplate_list().get_curr_plate_index() != plate_index &&
+                plater.select_plate(plate_index, false) != 0)
+                throw RpcError("NATIVE_ERROR", "Native plate selection failed");
+            const auto revision = plate_state(plater)["plateRevision"].get<std::string>();
+            const Json request = {{"plateIndex", plate_index}, {"expectedPlateRevision", revision}};
+            const auto child_state = start_slice(plater, request);
+            const auto child_id = child_state["jobId"].get<std::string>();
+            auto* child = slice_jobs.find(child_id);
+            if (!child) throw RpcError("NATIVE_ERROR", "Native slice job was not recorded");
+            batch->current_run = child->run;
+            if (child->worker_pending) return;
+            if (child->state != "succeeded") throw RpcError("NATIVE_ERROR", "Native plate slice failed to start");
+            batch->results.push_back({{"plateIndex", plate_index}, {"sliceResultId", child->result_id}, {"reused", child->reused}});
+            ++batch->next_index;
+            batch->current_run = 0;
+            if (batch->cancel_requested) {
+                if (batch->next_index >= batch->plate_indices.size()) finish_batch(*batch, "succeeded");
+                else {
+                    batch->stopped_plate_index = batch->plate_indices[batch->next_index];
+                    finish_batch(*batch, "cancelled");
+                }
+                return;
+            }
+        } catch (const std::exception& error) {
+            batch->stopped_plate_index = plate_index;
+            finish_batch(*batch, "failed", error.what());
+            return;
+        }
+    }
+    finish_batch(*batch, "succeeded");
+}
+
+void batch_child_completed(const McpSliceJob& child) {
+    for (auto& batch : slice_batches) {
+        if (batch.completion_observed || batch.current_run != child.run) continue;
+        batch.current_run = 0;
+        if (child.state == "succeeded") {
+            batch.results.push_back({{"plateIndex", child.plate_index}, {"sliceResultId", child.result_id}, {"reused", child.reused}});
+            ++batch.next_index;
+            if (batch.next_index >= batch.plate_indices.size()) { finish_batch(batch, "succeeded"); return; }
+            if (batch.cancel_requested) {
+                batch.stopped_plate_index = batch.plate_indices[batch.next_index];
+                finish_batch(batch, "cancelled");
+                return;
+            }
+        } else {
+            batch.stopped_plate_index = child.plate_index;
+            if (child.state == "cancelled") { finish_batch(batch, "cancelled"); return; }
+            finish_batch(batch, child.state == "stale" ? "stale" : "failed",
+                child.error_message.empty() ? "Native plate slice failed" : child.error_message);
+            return;
+        }
+        const auto id = batch.id;
+        const auto generation = mcp_domain_generation.load();
+        wxGetApp().CallAfter([id, generation] {
+            if (!mcp_publication_enabled.load() || mcp_domain_generation.load() != generation) return;
+            if (auto* plater = wxGetApp().plater()) advance_batch(*plater, id);
+        });
+        return;
+    }
+}
+
+Json start_batch(Plater& plater, const Json& params) {
+    check_plate_revision(plater, params);
+    require(!batch_active(), "A plate slice queue is already active");
+    require(!slice_jobs.active() && !plater.background_process().running() && !plater.background_process().mcp_orphans_running(),
+        "Native slicing is already active");
+    const int plate_count = plater.get_partplate_list().get_plate_count();
+    std::vector<int> indices;
+    if (params.contains("plateIndices")) {
+        require(params["plateIndices"].is_array() && !params["plateIndices"].empty() && params["plateIndices"].size() <= 32,
+            "plateIndices must contain 1 to 32 indices");
+        std::set<int> seen;
+        for (const auto& value : params["plateIndices"]) {
+            require(value.is_number_integer(), "Plate indices must be integers");
+            const auto number = value.get<long long>();
+            require(number >= 0 && number < plate_count, "Plate index is outside current state");
+            require(seen.insert(static_cast<int>(number)).second, "Plate indices must be unique");
+            indices.push_back(static_cast<int>(number));
+        }
+    } else {
+        require(plate_count <= 32, "Select at most 32 plates for one queue");
+        for (int i = 0; i < plate_count; ++i) indices.push_back(i);
+    }
+    while (slice_batches.size() >= 16) {
+        if (!slice_batches.front().completion_observed) throw RpcError("BUSY", "Plate queue history is full");
+        slice_batches.pop_front();
+    }
+    SliceBatchJob batch;
+    batch.id = session_id() + ":slice_batch:" + std::to_string(++next_batch_run);
+    batch.plate_indices = std::move(indices);
+    batch.input_fingerprint = slice_fingerprint(plater, true);
+    slice_batches.push_back(std::move(batch));
+    const auto id = slice_batches.back().id;
+    advance_batch(plater, id);
+    return batch_job_state(*find_batch_job(id));
+}
diff --git a/src/slic3r/GUI/McpCredentials.cpp b/src/slic3r/GUI/McpCredentials.cpp
new file mode 100644
index 0000000..8cb3334
--- /dev/null
+++ b/src/slic3r/GUI/McpCredentials.cpp
@@ -0,0 +1,231 @@
+#include "McpCredentials.hpp"
+
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <boost/filesystem/path.hpp>
+#include <openssl/rand.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <aclapi.h>
+#include <boost/nowide/convert.hpp>
+#else
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace Slic3r::GUI {
+namespace {
+
+constexpr size_t token_bytes = 32;
+constexpr size_t token_chars = token_bytes * 2;
+
+std::string token_path(const std::string &profile_dir)
+{
+    return (boost::filesystem::path(profile_dir) / "mcp.token").string();
+}
+
+bool new_token(std::string &token)
+{
+    std::array<unsigned char, token_bytes> bytes{};
+    if (RAND_bytes(bytes.data(), int(bytes.size())) != 1)
+        return false;
+    static constexpr char hex[] = "0123456789abcdef";
+    token.resize(token_chars);
+    for (size_t i = 0; i < bytes.size(); ++i) {
+        token[i * 2]     = hex[bytes[i] >> 4];
+        token[i * 2 + 1] = hex[bytes[i] & 15];
+    }
+    return true;
+}
+
+bool valid_token(const std::string &token)
+{
+    if (token.size() != token_chars)
+        return false;
+    for (char c : token)
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+            return false;
+    return true;
+}
+
+#ifdef _WIN32
+
+struct WindowsAcl {
+    HANDLE user_token = nullptr;
+    PACL acl = nullptr;
+    std::vector<BYTE> user_info;
+    SECURITY_DESCRIPTOR descriptor{};
+    SECURITY_ATTRIBUTES attributes{};
+
+    ~WindowsAcl()
+    {
+        if (acl) LocalFree(acl);
+        if (user_token) CloseHandle(user_token);
+    }
+
+    bool init()
+    {
+        if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &user_token)) return false;
+        DWORD size = 0;
+        GetTokenInformation(user_token, TokenUser, nullptr, 0, &size);
+        if (!size) return false;
+        user_info.resize(size);
+        if (!GetTokenInformation(user_token, TokenUser, user_info.data(), size, &size)) return false;
+
+        EXPLICIT_ACCESSW access{};
+        access.grfAccessPermissions = FILE_ALL_ACCESS;
+        access.grfAccessMode = SET_ACCESS;
+        access.grfInheritance = NO_INHERITANCE;
+        access.Trustee.TrusteeForm = TRUSTEE_IS_SID;
+        access.Trustee.TrusteeType = TRUSTEE_IS_USER;
+        access.Trustee.ptstrName = reinterpret_cast<LPWSTR>(reinterpret_cast<TOKEN_USER *>(user_info.data())->User.Sid);
+        if (SetEntriesInAclW(1, &access, nullptr, &acl) != ERROR_SUCCESS) return false;
+        if (!InitializeSecurityDescriptor(&descriptor, SECURITY_DESCRIPTOR_REVISION)) return false;
+        if (!SetSecurityDescriptorDacl(&descriptor, TRUE, acl, FALSE)) return false;
+        if (!SetSecurityDescriptorControl(&descriptor, SE_DACL_PROTECTED, SE_DACL_PROTECTED)) return false;
+        attributes.nLength = sizeof(attributes);
+        attributes.lpSecurityDescriptor = &descriptor;
+        return true;
+    }
+};
+
+bool read_token(const std::string &path, std::string &token, std::string &error)
+{
+    WindowsAcl security;
+    if (!security.init()) { error = "Cannot secure the MCP credential file"; return false; }
+    const std::wstring wide = boost::nowide::widen(path);
+    HANDLE file = CreateFileW(wide.c_str(), GENERIC_READ | READ_CONTROL | WRITE_DAC, FILE_SHARE_READ,
+                              nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+    if (file == INVALID_HANDLE_VALUE) { error = "Cannot open the MCP credential file"; return false; }
+    BY_HANDLE_FILE_INFORMATION info{};
+    const bool regular = GetFileInformationByHandle(file, &info) && !(info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) &&
+                         !(info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+    const bool secured = regular && SetSecurityInfo(file, SE_FILE_OBJECT,
+        DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION, nullptr, nullptr, security.acl, nullptr) == ERROR_SUCCESS;
+    char buffer[token_chars + 2]{};
+    DWORD size = 0;
+    const bool readable = secured && ReadFile(file, buffer, DWORD(sizeof(buffer)), &size, nullptr);
+    CloseHandle(file);
+    if (!readable || (size != token_chars && !(size == token_chars + 1 && buffer[token_chars] == '\n'))) {
+        error = "The MCP credential file is invalid or cannot be secured";
+        return false;
+    }
+    token.assign(buffer, token_chars);
+    if (!valid_token(token)) { error = "The MCP credential file is invalid"; return false; }
+    return true;
+}
+
+bool write_new_token(const std::string &path, const std::string &token, std::string &error)
+{
+    WindowsAcl security;
+    if (!security.init()) { error = "Cannot secure the MCP credential file"; return false; }
+    const std::wstring wide = boost::nowide::widen(path);
+    HANDLE file = CreateFileW(wide.c_str(), GENERIC_WRITE, 0, &security.attributes, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) { error = "Cannot create the MCP credential file"; return false; }
+    const std::string content = token + "\n";
+    DWORD size = 0;
+    const bool written = WriteFile(file, content.data(), DWORD(content.size()), &size, nullptr) && size == content.size() && FlushFileBuffers(file);
+    CloseHandle(file);
+    if (!written) {
+        DeleteFileW(wide.c_str());
+        error = "Cannot write the MCP credential file";
+    }
+    return written;
+}
+
+bool replace_token(const std::string &temp, const std::string &path, std::string &error)
+{
+    const std::wstring temp_wide = boost::nowide::widen(temp);
+    const std::wstring path_wide = boost::nowide::widen(path);
+    if (MoveFileExW(temp_wide.c_str(), path_wide.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return true;
+    DeleteFileW(temp_wide.c_str());
+    error = "Cannot replace the MCP credential file";
+    return false;
+}
+
+#else
+
+bool read_token(const std::string &path, std::string &token, std::string &error)
+{
+    int fd = open(path.c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) { error = "Cannot open the MCP credential file"; return false; }
+    struct stat info{};
+    const bool secured = fstat(fd, &info) == 0 && S_ISREG(info.st_mode) && info.st_uid == geteuid() &&
+                         fchmod(fd, S_IRUSR | S_IWUSR) == 0;
+    char buffer[token_chars + 2]{};
+    const ssize_t size = secured ? read(fd, buffer, sizeof(buffer)) : -1;
+    close(fd);
+    if (size != token_chars && !(size == token_chars + 1 && buffer[token_chars] == '\n')) {
+        error = "The MCP credential file is invalid or cannot be secured";
+        return false;
+    }
+    token.assign(buffer, token_chars);
+    if (!valid_token(token)) { error = "The MCP credential file is invalid"; return false; }
+    return true;
+}
+
+bool write_new_token(const std::string &path, const std::string &token, std::string &error)
+{
+    int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, S_IRUSR | S_IWUSR);
+    if (fd < 0) { error = "Cannot create the MCP credential file"; return false; }
+    const std::string content = token + "\n";
+    const bool written = write(fd, content.data(), content.size()) == ssize_t(content.size()) && fsync(fd) == 0;
+    close(fd);
+    if (!written) {
+        unlink(path.c_str());
+        error = "Cannot write the MCP credential file";
+    }
+    return written;
+}
+
+bool replace_token(const std::string &temp, const std::string &path, std::string &error)
+{
+    if (rename(temp.c_str(), path.c_str()) == 0) return true;
+    unlink(temp.c_str());
+    error = "Cannot replace the MCP credential file";
+    return false;
+}
+
+#endif
+
+}
+
+bool load_or_create_mcp_token(const std::string &profile_dir, std::string &token, std::string &error)
+{
+    error.clear();
+    if (profile_dir.empty()) { error = "The MCP profile directory is unavailable"; return false; }
+    const std::string path = token_path(profile_dir);
+#ifdef _WIN32
+    const DWORD attributes = GetFileAttributesW(boost::nowide::widen(path).c_str());
+    const bool exists = attributes != INVALID_FILE_ATTRIBUTES;
+#else
+    struct stat info{};
+    const bool exists = lstat(path.c_str(), &info) == 0;
+#endif
+    if (exists) return read_token(path, token, error);
+    if (!new_token(token)) { error = "Cannot generate an MCP credential"; return false; }
+    if (write_new_token(path, token, error)) return true;
+    if (!read_token(path, token, error)) return false;
+    error.clear();
+    return true;
+}
+
+bool regenerate_mcp_token(const std::string &profile_dir, std::string &token, std::string &error)
+{
+    error.clear();
+    if (profile_dir.empty()) { error = "The MCP profile directory is unavailable"; return false; }
+    std::string suffix;
+    if (!new_token(token) || !new_token(suffix)) { error = "Cannot generate an MCP credential"; return false; }
+    const std::string path = token_path(profile_dir);
+    const std::string temp = path + "." + suffix.substr(0, 16) + ".tmp";
+    if (!write_new_token(temp, token, error)) return false;
+    return replace_token(temp, path, error);
+}
+
+}
