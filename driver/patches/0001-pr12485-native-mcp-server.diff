+int main()
+{
+    try {
+        protocol_tests();
+        cancellation_tests();
+        credential_tests();
+        gcode_export_tests();
+        std::cout << checks.load() << " MCP checks passed\n";
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
